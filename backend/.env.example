DEBUG=true
SIP_POSTGRES_DB_SERVER=postgres
SIP_POSTGRES_DB_NAME=postgres
SIP_POSTGRES_DB_PORT=5432
SIP_POSTGRES_DB_USER=postgres
SIP_POSTGRES_DB_PW=postgres
SECRET_KEY=5fcfacda13cd6e44e358f1109094a82d3319dd3631f2def507e5af4b4679a65c
# Required: replace with the notification service hostname and port.
NOTIFICATION_API_URL=notifications.example.org:443
# Set false explicitly for a plaintext internal gRPC listener (e.g. port 6781).
# Bearer tokens then rely on the infrastructure for transport protection.
NOTIFICATION_API_TLS=true
VISIT_FRONTEND_SERVER_URL=http://localhost:3000
DEFAULT_NOTIFICATION_EMAIL=kontaktparty@vis.ethz.ch

SIP_AUTH_OIDC_ISSUER=http://localhost:8181/realms/VSETH
SIP_AUTH_OIDC_AUTH_ENDPOINT=http://localhost:8181/realms/VSETH/protocol/openid-connect/auth
# This client handles both user login and service-account mail authentication.
# Service accounts and the notification API permissions must be enabled.
SIP_AUTH_OIDC_CLIENT_ID=vis_cat_prod_visit3_oidc
KEYCLOAK_CALLBACK=http://localhost:8000/api/auth/callback
# Supply the registered client secret before starting the backend.
SIP_AUTH_OIDC_CLIENT_SECRET=
# Both flows use this endpoint; an HTTPS endpoint is required for mail.
SIP_AUTH_OIDC_TOKEN_ENDPOINT=https://identity.example.org/realms/VSETH/protocol/openid-connect/token
SIP_AUTH_OIDC_JWKS_URL=http://keycloak:8181/realms/VSETH/protocol/openid-connect/certs
KEYCLOAK_ALGORITHM=RS256

VISIT_KP_PRESIDENT_ROLE=admin

ADMIN_GROUP=admin
SIP_S3_FILES_HOST=rclone
SIP_S3_FILES_PORT=9000
SIP_S3_FILES_USE_SSL=false
SIP_S3_FILES_ACCESS_KEY=rclone
SIP_S3_FILES_SECRET_KEY=rclone123
SIP_S3_FILES_BUCKET=visit
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
LOG_LEVEL=INFO
